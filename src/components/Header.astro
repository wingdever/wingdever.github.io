---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<a href="/">首页</a>
			<a href="/blog">博客</a>
			<a href="/about">关于</a>
			<a href="/fullstack">全栈</a>
			<a href="/gamedev">游戏</a>
			<a href="/embedded">嵌入式</a>
			<a href="/search">搜索</a>
		</div>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em 1em;
		max-width: 720px;
		margin: auto;
		padding: 1em;
	}
	a {
		border-bottom: none;
		color: var(--text);
		font-size: 0.95rem;
	}
	a:hover {
		color: var(--muted);
	}
	.brand {
		font-weight: 700;
	}
	.links {
		display: flex;
		gap: 1.25em;
	}
</style>
