---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	AUTHOR,
	EDUCATION,
	EXPERIENCE,
	INTRO,
	JOB_TITLE,
	LOCATION,
	PROJECTS,
	TARGET,
	SELF_EVALUATION,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SKILLS,
	SOCIAL_LINKS,
} from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${JOB_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="resume-head">
				<h1>{AUTHOR}</h1>
				<p class="job-title">{JOB_TITLE} · 现居{LOCATION}</p>
				<p class="target">{TARGET}</p>
				<p class="intro">{INTRO}</p>
				<p class="contact">
					{SOCIAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
				</p>
				<p class="alt-resume">另见：<a href="/gamedev">游戏开发简历</a> · <a href="/fullstack">全栈工程师简历</a> · <a href="/embedded">嵌入式软件工程师简历</a></p>
			</header>

			<section>
				<h2>教育背景</h2>
				<div class="row">
					<strong>{EDUCATION.school}</strong>
					<span class="period">{EDUCATION.period}</span>
				</div>
				<p>{EDUCATION.major}</p>
				<p class="muted">相关课程：{EDUCATION.courses}</p>
			</section>

			<section>
				<h2>专业技能</h2>
				<dl class="skills">
					{SKILLS.map((skill) => (
						<div>
							<dt>{skill.title}</dt>
							<dd>{skill.detail}</dd>
						</div>
					))}
				</dl>
			</section>

			<section>
				<h2>工作经历</h2>
				{EXPERIENCE.map((job) => (
					<article class="entry">
						<div class="row">
							<h3>{job.company}</h3>
							<span class="period">{job.period}</span>
						</div>
						<p class="role">{job.role}</p>
						<ul>
							{job.points.map((point) => <li>{point}</li>)}
						</ul>
					</article>
				))}
			</section>

			<section>
				<h2>项目经历</h2>
				{PROJECTS.map((project) => (
					<article class="entry">
						<div class="row">
							<h3><a href={project.href}>{project.title}</a></h3>
							<span class="period">{project.period}</span>
						</div>
						<p class="tech">{project.tech}</p>
						{project.href && (
							<p class="repo-url">GitHub：<a href={project.href}>{project.href}</a></p>
						)}
						<ul>
							{project.points.map((point) => <li>{point}</li>)}
						</ul>
					</article>
				))}
			</section>

			<section>
				<h2>自我评价</h2>
				<ul>
					{SELF_EVALUATION.map((item) => <li>{item}</li>)}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.resume-head {
		margin-bottom: 3em;
	}
	.resume-head h1 {
		margin-bottom: 0.2em;
	}
	.job-title {
		color: var(--muted);
		margin-bottom: 0.4em;
	}
	.target {
		font-weight: 700;
		margin-bottom: 1em;
	}
	.intro {
		max-width: 34em;
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
	}
	.alt-resume {
		margin: 0.75em 0 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	section {
		margin-bottom: 3em;
	}
	h2 {
		margin-bottom: 1em;
		padding-bottom: 0.3em;
		border-bottom: 1px solid var(--border);
	}
	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
	}
	.period {
		color: var(--muted);
		font-size: 0.9rem;
		white-space: nowrap;
	}
	.muted,
	.role {
		color: var(--muted);
	}
	.skills {
		margin: 0;
	}
	.skills > div {
		display: grid;
		grid-template-columns: 6em 1fr;
		gap: 1em;
		padding: 0.5em 0;
	}
	.skills dt {
		font-weight: 700;
	}
	.skills dd {
		margin: 0;
		color: var(--muted);
	}
	.entry {
		margin-bottom: 2em;
	}
	.entry h3 {
		margin: 0;
		font-size: 1.1rem;
	}
	.entry h3 a {
		border-bottom: none;
		color: var(--text);
	}
	.tech {
		margin: 0.3em 0 0;
		color: var(--muted);
		font-size: 0.85rem;
	}
	.repo-url {
		margin: 0.25em 0 0;
		color: var(--muted);
		font-size: 0.8rem;
		word-break: break-all;
	}
	.repo-url a {
		border-bottom: none;
		color: var(--muted);
	}
	.repo-url a:hover {
		color: var(--text);
	}
	.entry ul {
		margin: 0.5em 0 0;
		padding-left: 1.3em;
	}
	.entry li {
		margin-bottom: 0.4em;
	}
	@media (max-width: 600px) {
		.row {
			flex-direction: column;
			gap: 0.2em;
		}
		.skills > div {
			grid-template-columns: 1fr;
			gap: 0.2em;
		}
	}
</style>
