---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import {
	AUTHOR,
	INTRO,
	LOCATION,
	PROJECTS,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SOCIAL_LINKS,
} from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{AUTHOR}</h1>
				<p>{INTRO}</p>
				<p class="muted">{LOCATION}</p>
			</section>

			<section>
				<h2>项目</h2>
				<ul class="plain">
					{PROJECTS.map((project) => (
						<li>
							<a href={project.href}>{project.title}</a>
							<p class="muted">{project.description}</p>
						</li>
					))}
				</ul>
			</section>

			<section>
				<h2>最近文章</h2>
				<ul class="plain">
					{posts.map((post) => (
						<li class="post">
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="muted"><FormattedDate date={post.data.pubDate} /></span>
						</li>
					))}
				</ul>
				<p><a href="/blog">查看全部文章 &rarr;</a></p>
			</section>

			<section>
				<h2>联系</h2>
				<p class="contact-links">
					{SOCIAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		margin-bottom: 3em;
	}
	.intro h1 {
		margin-bottom: 0.5em;
	}
	.plain {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.plain li {
		margin-bottom: 1em;
	}
	.plain li p {
		margin: 0.25em 0 0;
	}
	.post {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
	}
	.post .muted {
		white-space: nowrap;
		font-size: 0.9em;
	}
	.muted {
		color: var(--muted);
	}
	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
	}
</style>
